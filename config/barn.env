# Defaults for the commands in bin/, in dotenv format: KEY=value, one per line.
# The bin/ launchers load this file, but anything already set in your shell
# wins, e.g.:  BARN_OP_VAULT=Scratch barn-op list-items

# 1Password vault the barn-op commands read and write.
BARN_OP_VAULT="Home Infrastructure"
# How barn reaches 1Password: auto (read-only service account token if there is
# one, else the desktop app with Touch ID), service-account (token required) or
# desktop. Commands that write to 1Password always use the desktop app.
# See docs/1password-service-account.md.
BARN_OP_AUTH=auto
# macOS Keychain item (generic password, this service name) holding the service
# account token. The launchers read it when OP_SERVICE_ACCOUNT_TOKEN isn't set.
BARN_OP_KEYCHAIN_SERVICE=barn.op.service-account
# Desktop app sign-in, used for writes and when there's no token: the account
# *name* shown at the top of the app's sidebar (not the account ID that op and
# Terraform use; lib/shell/op-env.sh sets that one).
BARN_OP_ACCOUNT=Navettas
# Internal DNS zone; hosts are <name>.$BARN_HOME_DOMAIN.
BARN_HOME_DOMAIN=home.cowshed.cc
# 1Password item with the Cloudflare admin token barn-cf rolls other tokens with
# (account permission "Account API Tokens Write"); see docs/barn-cf.md.
BARN_CF_ADMIN_ITEM=barn.cloudflare.token-admin
