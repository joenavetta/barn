# Defaults for the commands in bin/, in dotenv format: KEY=value, one per line.
# The bin/ launchers load this file, but anything already set in your shell
# wins, e.g.:  BARN_OP_VAULT=Scratch barn-op list-items

# 1Password vault the barn-op commands read and write.
BARN_OP_VAULT="Home Infrastructure"
# Account for the 1Password SDK's desktop app sign-in: the account *name* shown
# at the top of the app's sidebar (not the account ID that op and Terraform use).
BARN_OP_ACCOUNT=Navettas
# Internal DNS zone; hosts are <name>.$BARN_HOME_DOMAIN.
BARN_HOME_DOMAIN=home.cowshed.cc
# 1Password item with the Cloudflare admin token barn-cf rolls other tokens with
# (account permission "Account API Tokens Write"); see docs/barn-cf.md.
BARN_CF_ADMIN_ITEM=barn.cloudflare.token-admin
