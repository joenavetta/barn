# --- Terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# NOTE: .terraform.lock.hcl IS committed on purpose.

# --- Secrets & credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
*.secret
*.secrets
*.age
!*.sops.*

# --- Device config exports (contain password hashes / keys) ---
config/opnsense/*.xml
config/unifi/*.unf
config/unifi/backups/


# --- Editors / OS ---
.idea/
*.iml
*.iws
.vscode/
.DS_Store
*.swp

# --- Python (lib/python) ---
.venv/
__pycache__/
*.pyc
