#!/usr/bin/env bash
# barn-tf: run terraform with 1Password credentials set up for the onepassword
# provider. Use it in place of `terraform`, e.g. `barn-tf plan` in a stack dir.
# Loads config/barn.env (shell environment wins), then sets exactly one of:
#   OP_SERVICE_ACCOUNT_TOKEN  service account token (env or macOS Keychain)
#   OP_ACCOUNT                desktop app sign-in (Touch ID), from BARN_OP_ACCOUNT_ID
# The provider refuses to start if both are set, so the other is unset.
set -euo pipefail

src=${BASH_SOURCE[0]}
while [[ -L $src ]]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  [[ $src == /* ]] || src=$dir/$src
done
BARN_ROOT=$(cd -P "$(dirname "$src")/.." && pwd)
export BARN_ROOT

# shellcheck source=../lib/shell/barn-env.sh
. "$BARN_ROOT/lib/shell/barn-env.sh"
barn_load_env "$BARN_ROOT/config/barn.env"
barn_op_auth

if [[ -n ${OP_SERVICE_ACCOUNT_TOKEN:-} ]]; then
  unset OP_ACCOUNT
else
  export OP_ACCOUNT=${OP_ACCOUNT:-${BARN_OP_ACCOUNT_ID:?BARN_OP_ACCOUNT_ID is not set (config/barn.env)}}
fi

command -v terraform >/dev/null || { echo "error: terraform not found (brew install hashicorp/tap/terraform)" >&2; exit 1; }
exec terraform "$@"
