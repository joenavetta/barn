#!/usr/bin/env bash
# barn-op: 1Password helpers (see `barn-op --help`).
# Thin wrapper: loads config/barn.env (shell environment wins), then runs the
# code in lib/python with uv. Works from any directory, including through a
# symlink, once bin/ is on PATH.
set -euo pipefail

src=${BASH_SOURCE[0]}
while [[ -L $src ]]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  [[ $src == /* ]] || src=$dir/$src
done
BARN_ROOT=$(cd -P "$(dirname "$src")/.." && pwd)
export BARN_ROOT

# shellcheck source=../lib/shell/barn-env.sh
. "$BARN_ROOT/lib/shell/barn-env.sh"
barn_load_env "$BARN_ROOT/config/barn.env"

command -v uv >/dev/null || { echo "error: uv not found (brew install uv)" >&2; exit 1; }
exec uv run --quiet --project "$BARN_ROOT/lib/python" barn-op "$@"
