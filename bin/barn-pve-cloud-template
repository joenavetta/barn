#!/usr/bin/env bash
# Build a cloud-init VM template on a Proxmox node. Run on the node itself.
# Usage: barn-pve-cloud-template <vmid> <name> <image-url> [storage] [bridge]
# Example:
#   barn-pve-cloud-template 9000 debian-13 \
#     https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
set -euo pipefail

VM_ID=${1:?vmid}
VM_NAME=${2:?name}
IMAGE_URL=${3:?image url}
STORAGE=${4:-local-zfs}
BRIDGE=${5:-vmbr0}

SNIPPETS=/var/lib/vz/snippets
IMAGE=/var/lib/vz/template/iso/$(basename "$IMAGE_URL")

mkdir -p "$SNIPPETS"
[[ -f $IMAGE ]] || wget -O "$IMAGE" "$IMAGE_URL"

# Vendor data: make sure the guest agent is installed on first boot.
cat > "$SNIPPETS/vendor-qemu-agent.yaml" <<'YAML'
#cloud-config
package_update: true
packages:
  - qemu-guest-agent
runcmd:
  - systemctl enable --now qemu-guest-agent
YAML

qm create "$VM_ID" --name "$VM_NAME" --memory 1024 --cores 1 \
  --net0 "virtio,bridge=$BRIDGE" --scsihw virtio-scsi-single \
  --ostype l26 --cpu host --agent enabled=1,fstrim_cloned_disks=1 \
  --serial0 socket --vga serial0
qm set "$VM_ID" --scsi0 "$STORAGE:0,import-from=$IMAGE,discard=on,iothread=1"
qm set "$VM_ID" --ide2 "$STORAGE:cloudinit" --boot order=scsi0
qm set "$VM_ID" --cicustom "vendor=local:snippets/vendor-qemu-agent.yaml"
qm template "$VM_ID"
echo "Template $VM_ID ($VM_NAME) created."
